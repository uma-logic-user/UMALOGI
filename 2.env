# ── Discord Webhook URLs ────────────────────────────────────────
DISCORD_WEBHOOK_URL=              # 予想・結果（必須・フォールバック基準）
DISCORD_WEBHOOK_SYSTEM=           # システムログ・エラー（旧: DISCORD_SYSTEM_WEBHOOK_URL から移行）
DISCORD_WEBHOOK_EV_ALERT=         # EV>=1.5 激熱レース専用（未設定時はpredictionへfallback）
DISCORD_WEBHOOK_AB_TEST=          # V1/V2 週次A/Bテスト比較レポート（未設定時はpredictionへfallback）
DISCORD_WEBHOOK_NOTE_DRAFT=       # note下書き出力（未設定時はシステムログ出力のみ）

# ── 旧変数（後方互換のため継続サポート） ─────────────────────────
# DISCORD_SYSTEM_WEBHOOK_URL=     # → DISCORD_WEBHOOK_SYSTEM として読み込み

# ── 通知有効フラグ ─────────────────────────────────────────────
NOTIFY_DISCORD=1
NOTIFY_LINE=1
NOTIFY_TWITTER=0

# ── note下書き投稿モード ──────────────────────────────────────
ENABLE_PLAYWRIGHT_POST=           # True にすると Playwright 自動投稿も実行（デフォルトOFF）
IS_PREMIUM_NOTE=                  # 1/true にすると有料コンテンツ全公開（省略時は無料版+セパレーター挿入）

# ── SNS認証情報 ───────────────────────────────────────────────
LINE_NOTIFY_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── モデル別投資停止フラグ ────────────────────────────────────
# W-048対応: 卍モデルの confidence=1.0 固定バグ修正完了まで 1 を設定
# 修正完了後はコメントアウトまたは削除すること
DISABLE_MANJI_BETS=1