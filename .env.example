# データベース設定
DB_PATH=data/umalogi.db

# ────────────────────────────────────────────────────────────────
# クラウドバックアップ設定
# ────────────────────────────────────────────────────────────────
# Google Drive / OneDrive 等のクラウド同期フォルダのパスを指定する。
# OS がバックグラウンドで自動アップロードするためAPIキー不要・シンプル。
# 設定すると backup_db() 実行時に DB と最新モデルを自動コピーする。
# 未設定（空欄）の場合はクラウド同期をスキップし、ローカルのみにバックアップする。
#
# 例（Google Drive）:
#   CLOUD_BACKUP_DIR=C:/Users/yourname/Google Drive/マイドライブ/UMALOGI_backup
# 例（OneDrive）:
#   CLOUD_BACKUP_DIR=C:/Users/yourname/OneDrive/UMALOGI_backup
CLOUD_BACKUP_DIR=

# ────────────────────────────────────────────────────────────────
# バンクロール設定
# ────────────────────────────────────────────────────────────────
# get_current_bankroll() が参照する初期資金。
# prediction_results テーブルの累積 profit がこの値に加算される。
INITIAL_BANKROLL=100000

# スクレイピング設定
SCRAPE_DELAY_SECONDS=1.5   # リクエスト間隔（サーバー負荷軽減）
SCRAPE_MAX_RETRIES=3       # リトライ上限回数
SCRAPE_TIMEOUT_SECONDS=10  # タイムアウト

# ログ設定
LOG_LEVEL=INFO             # DEBUG / INFO / WARNING / ERROR
