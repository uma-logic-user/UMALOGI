# ════════════════════════════════════════════════════════════════════════════════
# UMALOGI .env.example  —  本番運用時に .env へコピーして各値を設定すること
# ════════════════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────
# Discord Webhook URLs  (全5チャンネル)
# ────────────────────────────────────────────────────────────────
# 予想・的中結果の通常送信先（必須）
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# システムアラート専用チャンネル（スケジューラー例外・JVLink障害など）
# 未設定時は DISCORD_WEBHOOK_URL へフォールバック
DISCORD_WEBHOOK_SYSTEM=https://discord.com/api/webhooks/XXXX/YYYY
# 旧変数名（後方互換用 — DISCORD_WEBHOOK_SYSTEM が優先）
DISCORD_SYSTEM_WEBHOOK_URL=

# EV>=1.5 の激熱レース専用チャンネル (@everyone 付き)
DISCORD_WEBHOOK_EV_ALERT=https://discord.com/api/webhooks/XXXX/YYYY

# V1/V2 A/B テスト成績比較レポート
DISCORD_WEBHOOK_AB_TEST=https://discord.com/api/webhooks/XXXX/YYYY

# note.com 下書き転送チャンネル
DISCORD_WEBHOOK_NOTE_DRAFT=https://discord.com/api/webhooks/XXXX/YYYY

# ────────────────────────────────────────────────────────────────
# データベース設定
# ────────────────────────────────────────────────────────────────
DB_PATH=data/umalogi.db

# ────────────────────────────────────────────────────────────────
# バンクロール設定
# ────────────────────────────────────────────────────────────────
# get_current_bankroll() が参照する初期資金（円）
INITIAL_BANKROLL=100000

# ────────────────────────────────────────────────────────────────
# JVLink / JRA-VAN 設定
# ────────────────────────────────────────────────────────────────
# JRA-VAN Data Lab 加入者 SID
JRAVAN_SID=SA000000

# JVLink を完全に無効化する場合は 1 に設定（netkeiba フォールバック専用モード）
# 本番では設定しないこと（= JVLink 有効）
# JVLINK_DISABLED=1

# TARGET frontier JV の実行ファイルパス（自動起動用）
TARGET_JV_PATH=C:/Program Files (x86)/TARGET frontier JV/TargetJV.exe

# ────────────────────────────────────────────────────────────────
# note.com 設定
# ────────────────────────────────────────────────────────────────
NOTE_EMAIL=your-email@example.com
NOTE_PASSWORD=your-password

# 有料記事として投稿する場合は 1 に設定
# IS_PREMIUM_NOTE=1

# ────────────────────────────────────────────────────────────────
# Umanity 設定
# ────────────────────────────────────────────────────────────────
UMANITY_EMAIL=your-email@example.com
UMANITY_PASSWORD=your-password

# ────────────────────────────────────────────────────────────────
# X (Twitter) / Playwright 設定
# ────────────────────────────────────────────────────────────────
# X への自動投稿を有効化する場合は 1 に設定（Playwright 必要）
ENABLE_PLAYWRIGHT_POST=0

# X スクレイピングを有効化する場合は 1 に設定
# X_PLAYWRIGHT_ENABLED=1

# ────────────────────────────────────────────────────────────────
# Anthropic API (X シグナルパーサー / note記事生成 用)
# ────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ────────────────────────────────────────────────────────────────
# クラウドバックアップ設定（オプション）
# ────────────────────────────────────────────────────────────────
# Google Drive / OneDrive 等のクラウド同期フォルダのパスを指定する。
# 設定すると backup_db() 実行時に DB と最新モデルを自動コピーする。
# 例: CLOUD_BACKUP_DIR=C:/Users/yourname/Google Drive/マイドライブ/UMALOGI_backup
CLOUD_BACKUP_DIR=
