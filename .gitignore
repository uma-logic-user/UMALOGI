# ── データ（大容量・秘匿・ローカル専用）───────────────────────────
# SQLite DB（本番データ・個人情報を含む可能性あり）
data/umalogi.db
database.db

# SQLite WAL/SHM（稼働中プロセスが随時書き換える揮発ファイル・追跡禁止）
data/*.db-wal
data/*.db-shm

# 訓練済みモデル（数百MB になる場合がある）
data/models/
data/backups/

# DB バックアップ（各数百MB・GitHub 100MB 上限超のため追跡禁止 / W-054）
data/umalogi_backup_*.db

# 全資産バックアップ ZIP（scripts/backup_umalogi.py の出力・各数百MB・追跡禁止）
backups/

# 大容量バイナリ・生成データ（GitHub 推奨50MB超）
bin/*.exe
web/src/data/races.json

# 処理済み学習データ（Parquet、毎回再生成可能）
data/processed/

# 予想 JSON（毎回生成・大量ファイル）
data/predictions/

# スケジューラーログ
data/scheduler.log
data/auto_runner.log

# ── Next.js ──────────────────────────────────────────────────────
web/.next/
web/node_modules/
web/tsconfig.tsbuildinfo

# ── テスト一時ファイル ────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage

# ── 生成物（厳選note下書き・note記事出力）────────────────────────
dist/
outputs/note/
# 地方競馬（NAR）ライブデモの生成 Markdown（再生成可能・追跡禁止）
outputs/nar/

# ── その他 ────────────────────────────────────────────────────────
py

# ルート直下のスクラッチ/作業メモ（並行作業の一時ファイル）
/_*.txt
